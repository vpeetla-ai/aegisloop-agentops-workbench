{
  "buildCommand": "echo 'static demo'",
  "outputDirectory": "app",
  "rewrites": [
    {
      "source": "/api/aegisloop/health",
      "destination": "https://aegisloop-api.onrender.com/health"
    },
    {
      "source": "/api/aegisloop/api/:path*",
      "destination": "https://aegisloop-api.onrender.com/api/:path*"
    },
    {
      "source": "/api/missions/run",
      "destination": "https://aegisloop-api.onrender.com/api/missions/run"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
