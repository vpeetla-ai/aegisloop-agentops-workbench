# AegisLoop AgentOps — integration environment variables

# Proxy Netlify mission-run to full FastAPI runtime when deployed separately
AGENT_LOOP_API_URL=

# Optional Venkat AI Platform delegation (replaces local fleet when enabled)
VAP_API_BASE_URL=http://localhost:8000
VAP_DELEGATION_ENABLED=false
VAP_ORCHESTRATOR_ID=

# Optional AegisAI gateway for human-gated mission ship
AEGISAI_API_BASE_URL=
AEGISAI_GATEWAY_ENABLED=true
AEGISAI_GATEWAY_FAIL_OPEN=true
AEGISAI_AGENT_ID=aegisloop-agentops
AEGISAI_TENANT_ID=bank-demo
AEGISAI_PRINCIPAL_ID=agentops-orchestrator
AEGISAI_AUTH_BEARER=
AEGISAI_ROLES=workflow_owner,execution_broker

# Optional Langfuse export
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# API-key gate on /api/missions/run + /api/missions/stream (unset = open, dev/demo)
AEGISLOOP_API_KEY=

# Agent FinOps — real usage metering + a per-mission budget guard for research/
# content missions' real LLM calls. Unset AGENTFINOPS_API_URL: cost is computed
# locally, never reported as breached to agent-finops (no persisted ledger to
# check against) — the local MISSION_BUDGET_USD check still applies regardless.
AGENTFINOPS_API_URL=
AGENTFINOPS_API_KEY=
MISSION_BUDGET_USD=2.00
